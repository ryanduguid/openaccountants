# Store every text file with LF line endings and check it out with LF on every platform.
# A CRLF blob slipped into main on 4 October 2026 after a scripted edit on Windows; this
# setting keeps the clean filter normalising regardless of each contributor's core.autocrlf.
* text=auto eol=lf

# Binary formats are never normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Collapse generated outputs; review their source guides and generators.
/packages/** linguist-generated=true
/index.json linguist-generated=true
/PARTNERS.md linguist-generated=true
/llms-full.txt linguist-generated=true
/docs/COUNTRY-COVERAGE.md linguist-generated=true
/docs/FORM-REGISTER.md linguist-generated=true

# How scripts/merge-main.py (make merge-main) merges derived files: regenerate
# means `make build` rebuilds it; figures means hand-written text whose coverage
# figures `make build` writes; baseline means a gate baseline merged as a set.
# A plain `git merge` ignores this attribute.
/packages/** oa-merge=regenerate
/index.json oa-merge=regenerate
/PARTNERS.md oa-merge=regenerate
/llms-full.txt oa-merge=regenerate
/README.md oa-merge=figures
/llms.txt oa-merge=figures
/docs/QUALITY-TIERS.md oa-merge=figures
/docs/COVERAGE.md oa-merge=figures
/scripts/baselines/*.txt oa-merge=baseline

# Federal rates and their runbook are hand-authored and require review.
/packages/us-federal/** -linguist-generated -oa-merge
